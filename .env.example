# Application
APP_NAME=AgentShield
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield@postgres:5432/agentshield
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_EVENTS_TOPIC=agentshield-security-events
KAFKA_CONSUMER_GROUP=agentshield-group

# OpenSearch
OPENSEARCH_HOSTS=http://opensearch:9200
OPENSEARCH_INDEX=agentshield-events

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
AGENT_TOKEN_EXPIRATION_MINUTES=60

# Gateway
GATEWAY_DEFAULT_TIMEOUT=30
GATEWAY_MAX_BODY_SIZE=10485760  # 10MB
GATEWAY_REQUEST_TIMEOUT=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_MULTIPLIER=2

# Security
BCRYPT_ROUNDS=12
API_KEY_PREFIX=ak_
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentshield
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true