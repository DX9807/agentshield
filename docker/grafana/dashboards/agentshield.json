{
  "title": "AgentShield Security Dashboard",
  "uid": "agentshield",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Request Volume",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(agentshield_requests_total) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(agentshield_requests_total[5m])",
          "legendFormat": "{{decision}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Blocked Requests by Reason",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(agentshield_blocked_requests_total) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "title": "Risk Score Distribution",
      "type": "histogram",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, agentshield_risk_scores)",
          "legendFormat": "95th percentile"
        },
        {
          "expr": "histogram_quantile(0.50, agentshield_risk_scores)",
          "legendFormat": "50th percentile"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "title": "High-Risk Events",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(agentshield_high_risk_events_total)",
          "legendFormat": "Total"
        }
      ],
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 8},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        }
      }
    },
    {
      "title": "Gateway Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(agentshield_request_latency_seconds) by (le, agent_id))",
          "legendFormat": "P95 - {{agent_id}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(agentshield_request_latency_seconds) by (le, agent_id))",
          "legendFormat": "P99 - {{agent_id}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "title": "Policy Evaluation Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(agentshield_policy_evaluation_latency_seconds) by (le))",
          "legendFormat": "P95"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "title": "Active Tasks",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(agentshield_active_tasks)",
          "legendFormat": "Total active tasks"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}
    },
    {
      "title": "Sensitive Data Detections",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum(agentshield_sensitive_data_detected_total) by (classification)",
          "legendFormat": "{{classification}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}
    },
    {
      "title": "Rate Limit Hits",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(agentshield_rate_limit_hits_total)",
          "legendFormat": "Total"
        }
      ],
      "gridPos": {"h": 8, "w": 4, "x": 16, "y": 24}
    },
    {
      "title": "Top Agents by Activity",
      "type": "table",
      "targets": [
        {
          "expr": "topk(5, sum(agentshield_requests_total) by (agent_id))",
          "format": "table",
          "legendFormat": "{{agent_id}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}
    },
    {
      "title": "Top Blocked Agents",
      "type": "table",
      "targets": [
        {
          "expr": "topk(5, sum(agentshield_blocked_requests_total) by (agent_id))",
          "format": "table",
          "legendFormat": "{{agent_id}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}
    }
  ],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s"
}